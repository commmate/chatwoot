# Tico Mail Works - Environment Configuration
# Copy this file to .env and fill in the values
#
# Generate secrets with: openssl rand -hex 64

# ─── Domain Configuration ─────────────────────────────────
CRM_DOMAIN=crm.ticomailworks.ie
FRONTEND_URL=https://crm.ticomailworks.ie
EVOLUTION_DOMAIN=evolution.ticomailworks.ie
EVOLUTION_SERVER_URL=https://evolution.ticomailworks.ie
ACME_EMAIL=admin@ticomailworks.ie

# ─── Database ─────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ─── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ─── Rails Secret ─────────────────────────────────────────
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME_secret_key_base

# ─── Evolution API ────────────────────────────────────────
# Generate with: openssl rand -hex 32
EVOLUTION_API_KEY=CHANGE_ME_evolution_api_key

# ─── Email (Resend) ──────────────────────────────────────
MAILER_SENDER_EMAIL=noreply@ticomailworks.ie

# ─── SFTP ─────────────────────────────────────────────────
SFTP_PORT=2222
